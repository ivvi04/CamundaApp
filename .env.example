# ── Docker Compose ─────────────────────────────────────────────
POSTGRES_DB=camunda_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
# адреса внутри docker-сети
CAMUNDA_GRPC_ADDRESS=http://orchestration:26500
CAMUNDA_REST_ADDRESS=http://orchestration:8080

# ── Локальный запуск приложения (Spring читает этот файл) ──────
spring.datasource.url=jdbc:postgresql://localhost:5432/camunda_db
spring.datasource.username=${POSTGRES_USER}
spring.datasource.password=${POSTGRES_PASSWORD}
camunda.client.grpc-address=http://localhost:26500
camunda.client.rest-address=http://localhost:8082
